# Shopify App Credentials
SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here
SHOPIFY_SHOP_DOMAIN=ves.myshopify.com
SHOPIFY_ACCESS_TOKEN=your_access_token_here

# JWT Secret (generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Frontend URL (for CORS + the admin Gmail OAuth callback redirect).
# A localhost value here is fine and expected in development.
# It is NOT used for customer-facing links: those go through
# publicBaseUrl() in server/utils/publicUrl.js, which ignores any
# non-public origin and falls back to https://club.ves.sg. Never
# hand this variable straight to an email template.
FRONTEND_URL=http://localhost:5173

# Backend URL (Railway deployment — needed for Shopify webhook registration)
BACKEND_URL=https://your-app.up.railway.app

# Server Configuration
PORT=3000
NODE_ENV=development
