// VES Pottery Studio Database Schema
// Based on PRD v1.0

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// CORE TABLES
// ============================================

model Customer {
  id                    Int       @id @default(autoincrement())
  shopifyCustomerId     String    @unique @map("shopify_customer_id")
  email                 String    @unique
  firstName             String?   @map("first_name")
  lastName              String?   @map("last_name")
  customerType          String    @map("customer_type") // 'student', 'member', 'both'

  // Student fields
  coursePurchaseDate    DateTime? @map("course_purchase_date")
  courseExpiryDate      DateTime? @map("course_expiry_date")
  classesAllocated      Int       @default(6) @map("classes_allocated")
  classesUsed           Int       @default(0) @map("classes_used")
  classesForfeited      Int       @default(0) @map("classes_forfeited")

  // Member fields
  membershipTier        String?   @map("membership_tier") // 'standard', 'gold', 'platinum'
  membershipStartDate   DateTime? @map("membership_start_date")
  membershipEndDate     DateTime? @map("membership_end_date")

  // Metadata
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  lastSyncedAt          DateTime? @map("last_synced_at")

  // Relations
  potteryPieces         PotteryPiece[]
  bookings              Booking[]
  waitlistEntries       Waitlist[]
  notifications         Notification[]

  @@index([email])
  @@index([shopifyCustomerId])
  @@index([customerType])
  @@map("customers")
}

model PotteryPiece {
  id                Int       @id @default(autoincrement())
  customerId        Int       @map("customer_id")

  // Basic info
  title             String
  dateCompleted     DateTime  @map("date_completed")
  notes             String?   @db.Text

  // Technical details
  clayType          String    @map("clay_type")
  glazes            Json      @default("[]") // array of glaze names
  originalWeight    Decimal?  @map("original_weight") @db.Decimal(10, 2)
  finalWeight       Decimal?  @map("final_weight") @db.Decimal(10, 2)

  // Dimensions (in cm)
  height            Decimal?  @db.Decimal(10, 2)
  length            Decimal?  @db.Decimal(10, 2)
  width             Decimal?  @db.Decimal(10, 2)

  // Images
  images            Json      @default("[]") // array of image URLs

  // Organization
  tags              Json      @default("[]") // array of tag strings

  // Visibility
  isPublic          Boolean   @default(false) @map("is_public")
  featured          Boolean   @default(false)
  featuredOrder     Int?      @map("featured_order")

  // Metadata
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Relations
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([dateCompleted])
  @@index([clayType])
  @@index([isPublic])
  @@index([featured, featuredOrder])
  @@map("pottery_pieces")
}

model ClassTemplate {
  id              Int       @id @default(autoincrement())

  // Schedule
  dayOfWeek       Int       // 0=Sun, 6=Sat
  startTime       String    @map("start_time") // stored as HH:MM
  endTime         String    @map("end_time")

  // Class info
  classType       String    @map("class_type")
  instructor      String
  room            String?
  maxCapacity     Int       @map("max_capacity")

  // Status
  active          Boolean   @default(true)

  // Metadata
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  classInstances  ClassInstance[]

  @@index([dayOfWeek])
  @@index([active])
  @@map("class_templates")
}

model ClassInstance {
  id                  Int       @id @default(autoincrement())
  templateId          Int?      @map("template_id")

  // Date and time
  classDate           DateTime  @map("class_date")
  startTime           String    @map("start_time")
  endTime             String    @map("end_time")

  // Class info (denormalized for flexibility)
  classType           String    @map("class_type")
  instructor          String
  room                String?
  maxCapacity         Int       @map("max_capacity")
  currentEnrollment   Int       @default(0) @map("current_enrollment")

  // Status
  status              String    @default("active") // 'active', 'cancelled', 'completed'
  cancellationReason  String?   @map("cancellation_reason") @db.Text

  // Metadata
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  // Relations
  template            ClassTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  bookings            Booking[]
  waitlistEntries     Waitlist[]

  @@index([classDate])
  @@index([templateId])
  @@index([status])
  @@unique([classDate, startTime, room])
  @@map("class_instances")
}

model Booking {
  id                    Int       @id @default(autoincrement())
  studentId             Int       @map("student_id")
  classInstanceId       Int       @map("class_instance_id")

  // Booking info
  bookingDate           DateTime  @default(now()) @map("booking_date")

  // Status tracking
  status                String    @default("booked") // 'booked', 'cancelled', 'completed', 'forfeited'
  advanceNoticeGiven    Boolean   @default(false) @map("advance_notice_given")
  attended              Boolean?

  // Attendance
  markedByAdminId       Int?      @map("marked_by_admin_id")
  attendanceMarkedAt    DateTime? @map("attendance_marked_at")
  attendanceNotes       String?   @map("attendance_notes") @db.Text

  // Metadata
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // Relations
  student               Customer      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classInstance         ClassInstance @relation(fields: [classInstanceId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([classInstanceId])
  @@index([status])
  @@index([bookingDate])
  @@unique([studentId, classInstanceId])
  @@map("bookings")
}

model Waitlist {
  id                Int       @id @default(autoincrement())
  studentId         Int       @map("student_id")
  classInstanceId   Int       @map("class_instance_id")

  // Position tracking
  position          Int
  joinedAt          DateTime  @default(now()) @map("joined_at")

  // Notification tracking
  spotOfferedAt     DateTime? @map("spot_offered_at")
  notificationSentAt DateTime? @map("notification_sent_at")
  expiresAt         DateTime? @map("expires_at")

  // Claim status
  claimed           Boolean   @default(false)
  claimedAt         DateTime? @map("claimed_at")

  // Metadata
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Relations
  student           Customer      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classInstance     ClassInstance @relation(fields: [classInstanceId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([classInstanceId])
  @@index([position])
  @@index([expiresAt])
  @@unique([studentId, classInstanceId])
  @@map("waitlist")
}

model Notification {
  id                      Int       @id @default(autoincrement())
  customerId              Int       @map("customer_id")

  // Notification details
  type                    String    // 'course_expiry', 'waitlist_spot', 'class_reminder', etc.
  title                   String
  message                 String    @db.Text

  // Delivery
  emailSent               Boolean   @default(false) @map("email_sent")
  emailSentAt             DateTime? @map("email_sent_at")
  emailOpened             Boolean   @default(false) @map("email_opened")

  // Status
  read                    Boolean   @default(false)
  readAt                  DateTime? @map("read_at")

  // Related entities
  relatedClassInstanceId  Int?      @map("related_class_instance_id")
  relatedBookingId        Int?      @map("related_booking_id")
  relatedPieceId          Int?      @map("related_piece_id")

  // Metadata
  createdAt               DateTime  @default(now()) @map("created_at")

  // Relations
  customer                Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([type])
  @@index([read])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================
// HELPER TABLES
// ============================================

model ClayType {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?   @db.Text
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("clay_types")
}

model Glaze {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  colorHex    String?   @map("color_hex")
  description String?   @db.Text
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("glazes")
}

model AdminSetting {
  id           Int       @id @default(autoincrement())
  settingKey   String    @unique @map("setting_key")
  settingValue String    @map("setting_value") @db.Text
  description  String?   @db.Text
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("admin_settings")
}
